rules_version = '2';

// The browser uses Firebase Authentication only. All Firestore reads and writes
// are performed by trusted Next.js route handlers using the Firebase Admin SDK.
// Admin SDK access bypasses these rules; therefore application roles are
// enforced in server code with requireAdmin/requireRoles, never in client UI.
//
// Default-deny is intentional: do not add broad client access. Any future
// direct-client collection access must have a narrowly scoped rule and emulator
// tests proving that unauthenticated users and every disallowed role are denied.
service cloud.firestore {
  match /databases/{database}/documents {
    // OTP challenge records are server-only; Admin SDK route handlers bypass rules.
    match /adminOtpChallenges/{challengeId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
