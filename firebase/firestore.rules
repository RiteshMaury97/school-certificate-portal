rules_version = '2';


service cloud.firestore {
  match /databases/{database}/documents {
    // OTP challenge records are server-only; Admin SDK route handlers bypass rules.
    match /adminOtpChallenges/{challengeId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
