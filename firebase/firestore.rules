rules_version = '2';

// ---------------------------------------------------------------------------
// Firestore security rules
//
// Architecture: the browser never talks to Firestore. The browser SDK is used
// for Firebase Authentication only. Every read and write goes through Next.js
// route handlers that use the Firebase Admin SDK, which authenticates with a
// service account and BYPASSES these rules.
//
// Therefore the correct, safest rule set is "deny everything" for client
// SDKs. This protects student PII, admin records, sessions and audit logs even
// if the public Firebase web config (which is not secret) is abused.
//
// Do not add `allow` rules here. If a feature ever needs direct client access,
// add a narrowly scoped match for that one collection and write a rules test.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
