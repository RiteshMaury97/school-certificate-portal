{
  "name": "school-certificate-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-eslint-disables.mjs && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "backfill:certificate-ids": "node scripts/backfill-public-certificate-ids.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "retention:dry-run": "node scripts/expire-records.mjs",
    "retention:execute": "node scripts/expire-records.mjs --execute",
    "seed": "node scripts/seed-firestore.mjs",
    "admin:create-superadmin": "node scripts/create-first-superadmin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cleanup:storage-fields": "node scripts/cleanup-obsolete-certificate-storage-fields.mjs",
    "backfill:metrics": "node scripts/backfill-metrics.mjs",
    "migrate:student-pii": "node scripts/migrate-student-pii.mjs",
    "migrate:admin-roles": "node scripts/migrate-admin-roles.mjs",
    "migrate:legacy-published": "node scripts/migrate-legacy-published-certificates.mjs",
    "decrypt:export": "node scripts/decrypt-export.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "lhci autorun",
    "migrate:certificate-numbers": "node scripts/migrate-certificate-number-encryption.mjs",
    "backfill:r2-student-tags": "node scripts/backfill-r2-student-tags.mjs",
    "backfill:public-sessions": "node scripts/backfill-public-sessions.mjs",
    "restore:test": "node scripts/restore-test",
    "lint:fix": "node scripts/check-eslint-disables.mjs && eslint . --fix --max-warnings=0 && prettier --write .",
    "format": "prettier --write .",
    "lint:report": "node scripts/lint-report.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^10.22.0",
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.9.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.0.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-html": "^2.7.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "@sentry/cli@2.58.6": true,
    "unrs-resolver@1.12.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,scss,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
