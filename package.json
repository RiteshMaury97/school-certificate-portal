{
  "name": "school-certificate-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "backfill:certificate-ids": "node scripts/backfill-public-certificate-ids.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "retention:dry-run": "node scripts/expire-records.mjs",
    "retention:execute": "node scripts/expire-records.mjs --execute",
    "seed": "node scripts/seed-firestore.mjs",
    "admin:create-superadmin": "node scripts/create-first-superadmin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cleanup:storage-fields": "node scripts/cleanup-obsolete-certificate-storage-fields.mjs",
    "backfill:metrics": "node scripts/backfill-metrics.mjs",
    "migrate:student-pii": "node scripts/migrate-student-pii.mjs",
    "migrate:admin-roles": "node scripts/migrate-admin-roles.mjs",
    "migrate:legacy-published": "node scripts/migrate-legacy-published-certificates.mjs",
    "decrypt:export": "node scripts/decrypt-export.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "lhci autorun",
    "migrate:certificate-numbers": "node scripts/migrate-certificate-number-encryption.mjs",
    "backfill:r2-student-tags": "node scripts/backfill-r2-student-tags.mjs",
    "backfill:public-sessions": "node scripts/backfill-public-sessions.mjs",
    "restore:test": "node scripts/restore-test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
