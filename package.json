{
  "name": "school-certificate-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/maintenance/check-eslint-disables.mjs && eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "check:domain": "node scripts/check-domain-independence.mjs",
    "smoke": "node scripts/smoke/vercel-smoke.mjs",
    "backfill:certificate-ids": "node scripts/migrations/backfill-public-certificate-ids.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "seed": "node scripts/maintenance/seed-firestore.mjs",
    "admin:create-superadmin": "node scripts/admin/create-first-superadmin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cleanup:storage-fields": "node scripts/migrations/cleanup-obsolete-certificate-storage-fields.mjs",
    "backfill:metrics": "node scripts/migrations/backfill-metrics.mjs",
    "migrate:student-pii": "node scripts/migrations/migrate-student-pii.mjs",
    "migrate:admin-roles": "node scripts/migrations/migrate-admin-roles.mjs",
    "migrate:legacy-published": "node scripts/migrations/migrate-legacy-published-certificates.mjs",
    "decrypt:export": "node scripts/maintenance/decrypt-export.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "lhci autorun",
    "migrate:certificate-numbers": "node scripts/migrations/migrate-certificate-number-encryption.mjs",
    "backfill:r2-student-tags": "node scripts/migrations/backfill-r2-student-tags.mjs",
    "backfill:public-sessions": "node scripts/migrations/backfill-public-sessions.mjs",
    "restore:test": "node scripts/maintenance/restore-test.mjs",
    "lint:fix": "node scripts/maintenance/check-eslint-disables.mjs && eslint . --fix --max-warnings=0 && prettier --write .",
    "format": "prettier --write .",
    "lint:report": "node scripts/maintenance/lint-report.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "firebase:deploy:rules": "firebase deploy --only firestore",
    "admin:promote-superadmin": "node scripts/admin/promote-superadmin-by-uid.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@base-ui/react": "^1.9.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^11.10.0",
    "archiver": "^8.0.0",
    "exceljs": "^4.4.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "^16.0.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.0.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-html": "^2.7.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "firebase-tools": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "saxes": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "@sentry/cli@2.58.6": true,
    "unrs-resolver@1.12.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,scss,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
