# Firebase Authentication client configuration (browser SDK used for Auth only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# Server-only Firebase Admin credentials. Use ONE of the two options below.
# Option A (recommended): the service-account JSON, base64-encoded on one line:
#   base64 -w0 service-account.json      (macOS: base64 -i service-account.json)
# Never commit the JSON file itself. Delete it after encoding, and rotate the key
# in Google Cloud console if it was ever shared or committed.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
# Option B: individual values from the JSON (keep the \n escapes in the key)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# Local development only: set false to skip App Check on both browser and server.
# If unset and no NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY is configured, local development
# also skips App Check consistently. Set true only when testing with a valid site key
# and a registered Firebase App Check debug token. Production always enforces App Check.
APP_CHECK_ENFORCE=


# Cloudflare R2 - server-side only; never prefix these with NEXT_PUBLIC_
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# HMAC secrets: generate independent random values of at least 32 bytes each
SEARCH_HMAC_SECRET=
AUDIT_LOG_HMAC_SECRET=
CERTIFICATE_ACCESS_TOKEN_SECRET=
CERTIFICATE_NUMBER_HMAC_SECRET=
DISAMBIGUATION_HMAC_SECRET=
DISAMBIGUATION_CHALLENGE_SECRET=
# Base64-encoded 32-byte AES-256-GCM key for DOB/admission number encryption
STUDENT_PII_ENCRYPTION_KEY=

CERTIFICATE_NUMBER_ENCRYPTION_KEY= # base64-encoded 32-byte AES-256-GCM key

# Optional antivirus scan API: POST raw file bytes, return JSON {"clean":true} only when safe
ANTIVIRUS_SCAN_URL=
ANTIVIRUS_SCAN_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application
# Production must match the deployed origin. In development, localhost and 127.0.0.1 accept any port.
APP_ORIGIN=http://localhost:3000
PRIVACY_POLICY_VERSION=2026-10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=8

# Privacy / DPDP operational configuration
DATA_HOSTING_REGION=
RETENTION_YEARS=7

# Public privacy notice display configuration
NEXT_PUBLIC_DATA_HOSTING_REGION=
NEXT_PUBLIC_RETENTION_YEARS=7
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-10
# Weekly flag-only retention cron uses CRON_SECRET and siteSettings/main.retentionYears.
# It never deletes records automatically. Confirm the retention schedule in the admin UI.

# Public legal-page version
NEXT_PUBLIC_TERMS_VERSION=1.0

# Encrypted exports / scheduled private backup
# Generate a random 32-byte key and base64-encode it (server-only).
EXPORT_ENCRYPTION_KEY=
BACKUP_R2_BUCKET=
CRON_SECRET=
SITE_URL=https://your-school-domain.example

# Upload abuse quotas and R2 storage alert budget (defaults shown)
UPLOADS_PER_HOUR_LIMIT=60
UPLOADS_PER_DAY_LIMIT=300
UPLOAD_BYTES_PER_DAY_LIMIT=209715200
R2_STORAGE_BUDGET_BYTES=10737418240

# Consent-based certificate availability notifications (optional)
NOTIFICATION_OPT_OUT_SECRET=
# Gmail SMTP is the only outgoing email transport. Enable Google 2-Step Verification, then create a Google App Password.
# Admin mailboxes should enforce 2-Step Verification. Daily application cap: 500 recipients (warning at 400).
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME= # Optional sender display name; defaults to the school name

# Error monitoring (optional but recommended). Scrubbing removes request data, user identity,
# query strings, exception messages and breadcrumb payloads before events are sent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Privacy-friendly Plausible analytics (optional). Configure only aggregate page views;
# do not add custom events or capture any form/search fields.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Staging-only disaster-recovery test (never point this at production).
RESTORE_STAGING_PROJECT_ID=your-school-portal-staging
# Optional path for a machine-readable restore test log.
RESTORE_TEST_LOG=./restore-test-log.json

# Dedicated HMAC secret for administrator email-code challenges (minimum 32 bytes; independent of other HMAC secrets).
OTP_HMAC_SECRET=replace-with-a-random-32-byte-or-longer-secret
